{
    "name": "idetik/coretik",
    "description": "Idetik WP theme core",
    "type": "library",
    "minimum-stability": "stable",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/idetik/burner-email-providers"
        }
    ],
    "require": {
        "johnbillion/extended-cpts": "^5.0",
        "pimple/pimple": "^3.5",
        "nesbot/carbon": "^2.66",
        "pelago/emogrifier": "^7.0",
        "wesbos/burner-email-providers": "^1.0",
        "globalis/wp-cubi-helpers": "^1.0",
        "illuminate/collections": "^10.6",
        "globalis/wp-cubi-transient-cache": "^0.3.0"
    },
    "authors": [
        {
            "name": "David",
            "email": "david.daugreilh@idetik.fr"
        }
    ],
    "autoload": {
        "psr-4": { "Coretik\\": ["src"] },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Coretik\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13.6",
        "phpunit/phpunit": "^9.6",
        "brain/monkey": "^2.6",
        "phpstan/phpstan": "^2.1",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "php-stubs/acf-pro-stubs": "^6.8",
        "wp-phpunit/wp-phpunit": "^7.1",
        "yoast/phpunit-polyfills": "^4.0",
        "johnpbloch/wordpress-core": "^7.1"
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "test:integration": "phpunit -c phpunit-integration.xml.dist"
    },
    "suggest": {
        "idetik/coretik-navigation": "Navigation service, resolve breadcrumb and page title",
        "idetik/coretik-page-builder": "Page builder service",
        "freelancehunt/php-credit-card-validator": "Required by the payment-card-number and payment-card-cvc form constraints"
    }
}
