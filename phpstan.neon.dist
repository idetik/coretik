includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 5
    paths:
        - src
    excludePaths:
        # Templates: variables are provided by the including code
        - src/Services/*/views/*
    scanFiles:
        - vendor/php-stubs/acf-pro-stubs/acf-pro-stubs.php
    treatPhpDocTypesAsCertain: false
    # WP_Post::__get() exposes metas and menu items properties
    universalObjectCratesClasses:
        - WP_Post
    ignoreErrors:
        # Builder::make() forwards its arguments to the constructor of each builder
        - identifier: new.static
          path: src/Core/Builders/Traits/Maker.php
        # Public traits for projects, unused in the package itself
        - identifier: trait.unused
        # ACF Extended (optional)
        - identifier: function.notFound
          message: '#acfe_#'
        # Optional dependencies, only used when available
        - identifier: class.notFound
          message: '#(WP_CLI|Freelancehunt\\Validators\\CreditCard)#'
