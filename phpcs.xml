<?xml version="1.0"?>
<ruleset name="wp-cubi">
  <description>idetik coding standards</description>

  <!-- Scan all files in directory -->
  <file>.</file>

  <!-- Scan only PHP files -->
  <arg name="extensions" value="php"/>

  <!-- Ignore dependencies -->
  <exclude-pattern>/vendor/</exclude-pattern>

  <!-- Show colors in console -->
  <arg value="-colors"/>

  <!-- Show sniff codes in all reports -->
  <arg value="ns"/>

  <!-- Use PSR-12 as a base -->
  <rule ref="PSR12"/>
  
  <!-- Custom rule: disallow long `array()` syntax, use short `[]` syntax instead -->
  <rule ref="Generic.Arrays.DisallowLongArraySyntax"/>

  <!-- Method names imposed by WordPress classes -->
  <rule ref="PSR1.Methods.CamelCapsMethodName">
    <exclude-pattern>tests/Integration/*</exclude-pattern>
    <!-- WordPress Walker_Nav_Menu methods (start_lvl, start_el) -->
    <exclude-pattern>src/Services/Menu/Walkers/*</exclude-pattern>
  </rule>
</ruleset>